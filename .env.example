# Copy to .env for local development. Placeholders only: never commit real secrets.

# PostgreSQL (development uses a local server; see docs/DEPLOYMENT.md).
DATABASE_URL="postgresql://postgres@localhost:5432/ntoma_dev"
# Tests use a separate local database that is wiped on every run.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/ntoma_test"

# At least 32 random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Public address, used in payment return links and emails, e.g. https://ntoma.example
APP_URL="http://localhost:3000"

# Payments. PAYMENTS_MODE=sandbox enables the clearly-labelled test checkout (no real money).
# For real payments leave PAYMENTS_MODE empty and set the Paystack secret key.
PAYMENTS_MODE="sandbox"
PAYSTACK_SECRET_KEY=""

# SMS (Arkesel). Empty = SMS skipped (in-app notifications still work).
ARKESEL_API_KEY=""
SMS_SENDER_ID="Ntoma"

# Email (Resend). Empty = email skipped; in development verification/reset links are logged instead.
RESEND_API_KEY=""
EMAIL_FROM="Ntoma <no-reply@ntoma.example>"

# File storage: "local" (folder below) or "s3" (any S3-compatible bucket, e.g. Cloudflare R2).
# Check a bucket with: npm run storage:check
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed (prisma/seed.ts). For a local database, empty values use the development defaults
# (admin@ntoma.example / local-admin-password, demo accounts "demo-password"). For any other database
# ADMIN_EMAIL and ADMIN_PASSWORD (12+ characters) are required, and demo data is never seeded.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
DEMO_PASSWORD=""
# Deploys only: "catalogue-and-admin" seeds the catalogue and the administrator into an EMPTY database.
SEED_ON_EMPTY=""
# Deploys only: set to "true" for one deploy to convert a V1 database in place (see docs/MIGRATION_REHEARSAL.md).
ALLOW_V1_CONVERSION=""

# Shared secret for the scheduled maintenance endpoint (POST /api/cron).
CRON_SECRET=""
