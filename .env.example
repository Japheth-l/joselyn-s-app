# SQLite file for local development. Switch provider to "postgresql" in prisma/schema.prisma for production.
DATABASE_URL="file:./dev.db"
# Long random string used to sign login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public address of the app, used in payment return links, e.g. https://tailorconnect.com.gh
APP_URL="http://localhost:3000"

# Mobile Money / card payments via Paystack (https://dashboard.paystack.com -> Settings -> API Keys).
# Leave empty to use demo payments (no real money moves).
PAYSTACK_SECRET_KEY=""

# SMS via Arkesel (https://arkesel.com). Leave empty to only show in-app notifications.
ARKESEL_API_KEY=""
SMS_SENDER_ID="TailorConn"

# Folder where uploaded photos are stored.
UPLOAD_DIR="./uploads"
