# Copy to .env for local development. Placeholders only: never commit real secrets.

# PostgreSQL (development uses a local server; see docs/DEPLOYMENT.md).
DATABASE_URL="postgresql://postgres@localhost:5432/ntoma_dev"
# Tests use a separate local database that is wiped on every run.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/ntoma_test"

# At least 32 random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Public address, used in payment return links and emails, e.g. https://ntoma.example
APP_URL="http://localhost:3000"

# Payments. PAYMENTS_MODE=sandbox enables the clearly-labelled test checkout (no real money).
# For real payments leave PAYMENTS_MODE empty and set the Paystack secret key.
PAYMENTS_MODE="sandbox"
PAYSTACK_SECRET_KEY=""

# SMS (Arkesel). Empty = SMS skipped (in-app notifications still work).
ARKESEL_API_KEY=""
SMS_SENDER_ID="Ntoma"

# Email (Resend). Empty = email skipped; in development verification/reset links are logged instead.
RESEND_API_KEY=""
EMAIL_FROM="Ntoma <no-reply@ntoma.example>"

# File storage: "local" (folder below) or "s3" (any S3-compatible bucket).
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Seed: administrator account and demo data.
ADMIN_EMAIL="admin@ntoma.example"
ADMIN_PASSWORD=""
DEMO_PASSWORD=""
SEED_DEMO_DATA="false"

# Shared secret for the scheduled maintenance endpoint (POST /api/cron).
CRON_SECRET=""
