{
  "name": "ntoma",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.27",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.29"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "deploy:build": "node scripts/postgres-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma && next build",
    "deploy:start": "prisma db push --schema prisma/schema.postgres.prisma --skip-generate && tsx prisma/seed.ts --if-empty && next start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
